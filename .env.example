# Firebase Web SDK config — copy to .env and fill in. The
# `VITE_` prefix is what makes Vite inline these into the
# browser bundle at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3). The site key is public by design —
# it is bound to a domain list, not kept secret. Leave it unset
# and the app runs without attestation, which is fine until
# enforcement is turned on in the Firebase console.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Only honoured in `pnpm dev` builds, and never in a deployed
# environment. Leave it unset for real reCAPTCHA, which works
# from localhost as long as the site key lists it. Set it to
# `true` once to make the SDK mint a debug token and log it to
# the browser console; register that value in the App Check
# console and paste it back here so later runs reuse it.
#VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Used by scripts/* (rules deploy, balance repair), which run in
# Node and never see the VITE_ bundle. Leave them unset to reuse
# the VITE_ values above; set them to target another project.
#FIREBASE_PROJECT_ID=
#FIREBASE_STORAGE_BUCKET=

# Point scripts/recalc-balances.ts at the local emulator instead
# of production, e.g. 127.0.0.1:8080.
#FIRESTORE_EMULATOR_HOST=
