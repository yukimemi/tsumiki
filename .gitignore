# kata:gitignore:base:begin
# Editor / OS noise — kata-managed (yukimemi/pj-base).
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# APM dependencies — install output of apm.yml's deps.
# Skill files under .agents/, .claude/, .gemini/ etc. are
# committed (kata seeds them; renri post_create refreshes via
# `apm install --update`); the apm_modules/ source cache is not.
apm_modules/
# kata:gitignore:base:end
# kata:gitignore:pnpm:begin
# Node / pnpm — kata-managed (yukimemi/pj-pnpm).
node_modules/
dist/
build/
coverage/
.pnpm-store/
.eslintcache
.tsbuildinfo
*.tsbuildinfo

# Local env — committed envs go to .env.example instead.
.env
.env.*
!.env.example

# Tooling logs.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# kata:gitignore:pnpm:end

# Firebase emulator artefacts.
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Vercel CLI link state. `.env*` is deliberately NOT repeated here: the pnpm
# block above already ignores it and re-adds `!.env.example`, and a later
# `.env*` would win and drop the example file from the repo.
.vercel
