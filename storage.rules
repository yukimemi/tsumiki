rules_version = '2';

// tsumiki storage rules.
//
// Uploads live under households/{householdId}/, and membership only exists in
// Firestore, so these rules reach across services with firestore.get().
//
// Membership is the only gate. There used to be a second one — the global
// `config/access` allowlist — and removing it from firestore.rules was not
// enough: a cross-service firestore.get() runs with the storage service
// agent's privileges and ignores Firestore's own rules, so this file kept
// reading the sealed document and kept working. It worked only for the emails
// that happened to still be listed there, which is every existing member and
// no one who signs up from now on.
//
// One-time IAM grant required per project — without it every cross-service
// call returns null and uploads silently 403. The console grants it when you
// press Publish; the REST API (scripts/deploy-rules.ts, CI) does not:
//
//   gcloud projects add-iam-policy-binding <PROJECT_ID> \
//     --member="serviceAccount:service-<PROJECT_NUMBER>@gcp-sa-firebasestorage.iam.gserviceaccount.com" \
//     --role="roles/firebaserules.firestoreServiceAgent"
//
// IAM changes do not apply to the live ruleset retroactively: re-run
// `pnpm rules:deploy` afterwards to cut a fresh release.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function household(householdId) {
      return firestore.get(/databases/(default)/documents/households/$(householdId)).data;
    }

    function isMember(householdId) {
      return isSignedIn()
        && request.auth.uid in household(householdId).memberIds;
    }

    function isParent(householdId) {
      return isMember(householdId)
        && household(householdId).memberRoles.get(request.auth.uid, '')
            in ['owner', 'parent'];
    }

    // Proof-of-task photos: households/{id}/entries/{entryId}/{file}.
    //
    // Any member may upload, not just a parent. The whole point is that the
    // child who did the chore photographs it; a rule that only let parents
    // write would leave the evidence trail to the person it is evidence for.
    // The size and type caps stay: a phone camera produces 8 MB files and the
    // client downscales before upload, so anything near the cap is a bug or an
    // attempt to fill the bucket.
    match /households/{householdId}/entries/{entryId}/{file} {
      allow read: if isMember(householdId);
      allow create, update: if isMember(householdId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // Undo removes the photo with the completion, so a member has to be able
      // to delete their own. `request.resource` is null on delete, which is
      // why this is a separate rule.
      allow delete: if isMember(householdId);
    }

    // Anything else under a household stays parent-only.
    match /households/{householdId}/{allPaths=**} {
      allow read: if isMember(householdId);
      allow create, update: if isParent(householdId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isParent(householdId);
    }
  }
}
